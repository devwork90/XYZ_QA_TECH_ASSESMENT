          "start_time": 18.5,
          "end_time": 27.0,
          "confidence": 0.95
        },
        {
          "speaker_id": "customer_1",
          "text": "That would be great, thank you.",
          "start_time": 27.3,
          "end_time": 29.5,
          "confidence": 0.96
        },
        {
          "speaker_id": "agent_1",
          "text": "Perfect, I've sent that now. To summarize, I've sent you a password reset link. Once you receive it, click the link to create a new password. Is there anything else I can help you with today?",
          "start_time": 29.8,
          "end_time": 40.0,
          "confidence": 0.94
        },
        {
          "speaker_id": "customer_1",
          "text": "No, that's all. Thanks for your help!",
          "start_time": 40.3,
          "end_time": 43.0,
          "confidence": 0.97
        },
        {
          "speaker_id": "agent_1",
          "text": "You're welcome! Thank you for calling DataStream. Have a great day!",
          "start_time": 43.3,
          "end_time": 47.0,
          "confidence": 0.98
        }
